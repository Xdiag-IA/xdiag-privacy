# Copy to .env and adjust as needed. The defaults are tuned for local CPU.
#
# Set XDIAG_MOCK=1 to skip downloading the heavy models (~700MB) and use
# regex based heuristics for OCR + PII. Useful for first run smoke tests on
# constrained machines.

# XDIAG_MOCK=0
# XDIAG_OCR_USE_GPU=0
# XDIAG_PII_DEVICE=-1
# XDIAG_CONFIDENCE=0.5
# XDIAG_MAX_UPLOAD=20971520
# XDIAG_PII_MODEL=OpenMed/OpenMed-PII-Portuguese-SnowflakeMed-Large-568M-v1

# Modo servidor (docs/servidor.md). Perfil leve, sem Docker nem modelo local.
# A camada de IA ENVIA o texto do documento a um servico externo: so ligue se
# isso for aceitavel para o documento.
# XDIAG_OCR_ENGINE=tesseract
# XDIAG_PII_ENGINE=rules
# XDIAG_PII_LLM=claude
# XDIAG_LLM_MODEL=claude-sonnet-5
# XDIAG_TESSERACT_CMD=/usr/bin/tesseract
# XDIAG_TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata
