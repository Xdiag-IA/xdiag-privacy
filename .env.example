# Copy to .env and adjust as needed. The defaults are tuned for local CPU.
#
# Set XDIAG_MOCK=1 to skip downloading the heavy models (~700MB) and use
# regex based heuristics for OCR + PII. Useful for first run smoke tests on
# constrained machines.

# XDIAG_MOCK=0
# XDIAG_OCR_USE_GPU=0
# XDIAG_PII_DEVICE=-1
# XDIAG_CONFIDENCE=0.5
# XDIAG_MAX_UPLOAD=20971520
# XDIAG_PII_MODEL=OpenMed/OpenMed-PII-Portuguese-SnowflakeMed-Large-568M-v1
